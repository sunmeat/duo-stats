{
  "cleanUrls": true,
  "functions": {
    "src/api/card.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/card",
      "destination": "/src/api/card.js"
    },
    {
      "source": "/duoapi/:path*",
      "destination": "https://www.duolingo.com/:path*"
    },
    {
      "source": "/duoimg/:path*",
      "destination": "https://d3gq3s1iyyx31w.cloudfront.net/:path*"
    },
    {
      "source": "/duocdn/:path*",
      "destination": "https://s2.duolingo.com/:path*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
